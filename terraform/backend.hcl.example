# S3 backend configuration. Copy to backend.hcl and edit, then:
#   terraform init -backend-config=backend.hcl
#
# The bucket must exist first — create it with the one-time bootstrap in ./bootstrap.

bucket       = "elevator-tfstate-<account-id>"
key          = "elevator/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
