# Copy to terraform.tfvars and fill in. (terraform.tfvars is git-ignored.)

env_name   = "prod"
aws_region = "us-east-1"

# IAM Identity Center home region (leave "" to use aws_region)
idc_region = "eu-west-1"

elevator_admin_group      = "Elevator-Admins"
elevator_auditor_group    = "Elevator-Auditors"
elevator_idc_access_group = "Developers"

# Optional custom domain. Requires an ISSUED ACM cert in us-east-1 and a Route53
# hosted zone for the domain to already exist.
custom_domain = ""

# Allow localhost callback URLs (dev only)
allow_localhost = false
